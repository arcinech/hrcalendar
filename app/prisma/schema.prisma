generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  ARCHIVED
}

enum UserRole {
  ROLE_USER
  ROLE_HR
}

enum LeaveType {
  ANNUAL
  ON_DEMAND
  SPECIAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkDayOverrideType {
  WORKING
  NON_WORKING
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique @db.VarChar(180)
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  firstName      String     @map("first_name") @db.VarChar(100)
  lastName       String     @map("last_name") @db.VarChar(100)
  employeeNumber String?    @unique @map("employee_number") @db.VarChar(50)
  role           UserRole   @default(ROLE_USER)
  status         UserStatus @default(INVITED)
  archivedAt     DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  activationTokens    ActivationToken[]
  entitlements        Entitlement[]
  leaveRequests       LeaveRequest[] @relation("LeaveRequestOwner")
  decisionsMade       LeaveRequest[] @relation("LeaveRequestDecisionBy")
  cancellationsMade   LeaveRequest[] @relation("LeaveRequestCancellationBy")
  deadlineSnapshots   EntitlementDeadlineSnapshot[]
  auditEntries        AuditLog[] @relation("AuditActor")

  @@index([status, role])
  @@index([lastName, firstName])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model ActivationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("activation_tokens")
}

model Entitlement {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  year            Int
  annualLimitDays Int      @map("annual_limit_days")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([year])
  @@map("entitlements")
}

model LeaveRequest {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  startsOn   DateTime    @map("starts_on") @db.Date
  endsOn     DateTime    @map("ends_on") @db.Date
  type       LeaveType
  status     LeaveStatus @default(PENDING)
  reason     String      @db.VarChar(1000)
  publicNote String?     @map("public_note") @db.VarChar(250)
  workingDays Int        @default(0) @map("working_days")

  decidedById    String?   @map("decided_by_id") @db.Uuid
  decisionComment String?  @map("decision_comment") @db.VarChar(1000)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)

  cancelledById      String?   @map("cancelled_by_id") @db.Uuid
  cancellationComment String?  @map("cancellation_comment") @db.VarChar(1000)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee      User  @relation("LeaveRequestOwner", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy     User? @relation("LeaveRequestDecisionBy", fields: [decidedById], references: [id], onDelete: SetNull)
  cancelledBy   User? @relation("LeaveRequestCancellationBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  days          LeaveRequestDay[]

  @@index([userId, status, startsOn])
  @@index([status, type, startsOn])
  @@index([startsOn, endsOn])
  @@map("leave_requests")
}

model LeaveRequestDay {
  id                     String   @id @default(uuid()) @db.Uuid
  leaveRequestId         String   @map("leave_request_id") @db.Uuid
  date                   DateTime @db.Date
  working                Boolean
  nonWorkingReason       String?  @map("non_working_reason") @db.VarChar(255)
  chargedEntitlementYear Int?     @map("charged_entitlement_year")
  onDemandYear           Int?     @map("on_demand_year")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date])
  @@index([date, working])
  @@index([chargedEntitlementYear])
  @@index([onDemandYear])
  @@map("leave_request_days")
}

model WorkCalendarOverride {
  id        String              @id @default(uuid()) @db.Uuid
  date      DateTime            @unique @db.Date
  type      WorkDayOverrideType
  reason    String              @db.VarChar(500)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([date, type])
  @@map("work_calendar_overrides")
}

model EntitlementDeadlineSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  sourceYear           Int      @map("source_year")
  deadlineYear         Int      @map("deadline_year")
  unusedDaysAtDeadline Int      @map("unused_days_at_deadline")
  capturedAt           DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceYear])
  @@index([deadlineYear])
  @@map("entitlement_deadline_snapshots")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(50)
  subjectId   String?  @map("subject_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([subjectId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}
