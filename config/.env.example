# Copy this file to:
#   ./config/.env
#
# Copy to ./config/.env and pass it to Compose with:
#   docker compose --env-file ./config/.env up -d

# ------------------------------------------------------------------------------
# Host user
# ------------------------------------------------------------------------------
# Useful on Linux so files created by Bun inside the container belong to you.
APP_UID=1000
APP_GID=1000

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_PORT=3000

# Auth.js / NextAuth
# Generate a strong value before production use.
# Example:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=vacation_planner
POSTGRES_USER=vacation_planner
POSTGRES_PASSWORD=change-me

# Exposes PostgreSQL to the host. Change if port 5432 is already occupied.
POSTGRES_PORT=5432

# IMPORTANT:
# Inside Docker, the PostgreSQL hostname is the Compose service name "database",
# not localhost.
DATABASE_URL=postgresql://vacation_planner:change-me@database:5432/vacation_planner?schema=public

# ------------------------------------------------------------------------------
# Optional Nginx reverse proxy
# ------------------------------------------------------------------------------
# Start it with:
#   docker compose --profile web up -d
WEB_PORT=8080
